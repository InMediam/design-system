{
  "name": "inmediam-design-system",
  "author": "Douglas Duarte",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/InMediam/design-system"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=!@inmediam/docs && changeset publish",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@turbo/gen": "^1.9.7",
    "eslint": "^8.57.1",
    "prettier": "^2.5.1",
    "turbo": "^2.10.10",
    "vite": "^8.0.3"
  },
  "packageManager": "npm@10.9.2"
}
