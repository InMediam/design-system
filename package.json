{
  "name": "inmediam-design-system",
  "author": "Douglas Duarte",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/InMediam/design-system"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=!@inmediam/docs && changeset publish",
    "lint": "turbo run lint",
    "format": "turbo run format"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "turbo": "^2.11.7"
  },
  "packageManager": "npm@10.9.2",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.27.2": true
  }
}
